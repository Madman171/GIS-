# GIS交通路网教学知识图谱平台专属配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# 新建图谱数据库建议使用 traffic_kg；已有neo4j数据库时请保持实际数据库名。
NEO4J_DATABASE=traffic_kg

# GIS交通路网教学知识图谱业务配置
KG_MAX_LEARNING_PATH_LENGTH=8
ENABLE_TOPOLOGY_CHECK=true
TOPOLOGY_COORDINATE_TOLERANCE=1.0

# GIS交通路网教学问答引擎配置
ANSWER_MAX_REFERENCES=6
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_WHITELIST=

# 外部模型服务仅在平台内部调用，不向前端暴露
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=800
DEEPSEEK_TEMPERATURE=0.2

# 平台开发端口使用9080，兼容旧版5173端口
CORS_ALLOW_ORIGINS=http://localhost:9080,http://127.0.0.1:9080,http://localhost:5173,http://127.0.0.1:5173

